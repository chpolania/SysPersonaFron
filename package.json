{
  "name": "afwt-template-components-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "build": "tsc --build && vite build",
    "start": "node server/index.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "test": "vitest --config ./vitest.config.ts --run && npm run test:server",
    "test:server": "node --test server/*.test.mjs",
    "coverage": "vitest --config ./vitest.config.ts --run --coverage"
  },
  "dependencies": {
    "axios": "^1.7.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^15.10.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.41",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "sass": "^1.79.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^5.0.4"
  }
}
